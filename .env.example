# ============================================================
# VidStega - Environment Variables
# Copy to .env and fill in values before running docker compose
# ============================================================

# Flask
FLASK_ENV=production
# Generate with: openssl rand -hex 32
SECRET_KEY=your-strong-random-secret-key-here

# ----- Railway deployment only -----
# Redis is auto-injected by Railway plugin as REDIS_URL.
# Set these to ${{Redis.REDIS_URL}} in Railway Variables tab:
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# ----- Oracle Cloud / local Docker Compose -----
# Redis is handled internally by docker-compose.yml (no extra config needed)
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND default to redis://redis:6379/0

# Upload limits
MAX_UPLOAD_MB=500

# WebSocket
SOCKETIO_ASYNC_MODE=eventlet
