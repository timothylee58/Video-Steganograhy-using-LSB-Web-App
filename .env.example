# ============================================================
# VidStega - Environment Variables
# ============================================================

# Flask
FLASK_ENV=production
# Generate with: openssl rand -hex 32
SECRET_KEY=your-strong-random-secret-key-here

# WebSocket async mode
# Use "threading" on Koyeb free tier (0.1 vCPU)
# Use "eventlet" on Railway / Oracle Cloud (more resources)
SOCKETIO_ASYNC_MODE=threading

# Upload limits
MAX_UPLOAD_MB=500

# ----- Railway only -----
# Redis is auto-injected by Railway plugin as REDIS_URL.
# Set these to ${{Redis.REDIS_URL}} in Railway Variables tab:
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# ----- Oracle Cloud / local Docker Compose only -----
# Redis runs as a container — no extra config needed.
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND default to redis://redis:6379/0

# ----- Koyeb free tier -----
# No Redis available. App automatically falls back to synchronous processing.
# No extra env vars needed beyond FLASK_ENV, SECRET_KEY, PORT=8000, SOCKETIO_ASYNC_MODE=threading
